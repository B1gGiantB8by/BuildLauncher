<Window x:Class="Avalonia.Desktop.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pages="clr-namespace:Avalonia.Desktop.Pages"
        xmlns:vm="using:Avalonia.Desktop.ViewModels"
        Title="Build Launcher EX"
        MinWidth="1300"
        MinHeight="800"
        d:DesignHeight="800"
        d:DesignWidth="1300"
        x:DataType="vm:MainWindowViewModel"
        CanResize="True"
        ClipToBounds="True"
        ExtendClientAreaToDecorationsHint="True"
        Icon="/Assets/icon.ico"
        Opened="OnWindowOpened"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        mc:Ignorable="d">

    <Window.Styles>
        <Style Selector="Window:not(.mica)">
            <Setter Property="Background" Value="{DynamicResource Background}" />
        </Style>
        <Style Selector="Window.mica">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel &gt; TextBlock">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="0" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/ThemedResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource WindowBorder}"
            BorderThickness="1"
            IsHitTestVisible="True">

        <Grid RowDefinitions="25,*">

            <Border Grid.Row="0"
                    Grid.RowSpan="2"
                    Background="{DynamicResource BackdropBackground}"
                    IsHitTestVisible="False" />

            <Border Grid.Row="0"
                    Grid.RowSpan="2"
                    Background="{DynamicResource LauncherGlowBrush}"
                    IsHitTestVisible="False" />

            <Grid x:Name="ConsentWindow"
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  ColumnDefinitions="*,auto,*"
                  IsVisible="False"
                  RowDefinitions="*,auto,*"
                  ZIndex="999">

                <Canvas Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource ScrimBrush}"
                        IsHitTestVisible="True"
                        Opacity="0.5" />

                <Border Grid.Row="1"
                        Grid.Column="1"
                        MaxWidth="800"
                        Background="{DynamicResource Background}"
                        BorderBrush="{DynamicResource SystemAccentColor}"
                        BorderThickness="1">

                    <StackPanel Orientation="Vertical">

                        <TextBlock Margin="50"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap">
                            Build Launcher EX is a community-driven utility designed to help users manage and launch third-party source ports, mods, custom campaigns, and maps for their licensed Build Engine games.<LineBreak />
                            <LineBreak />
                            This Software is not affiliated with or endorsed by the original game rights holders or any associated entities.<LineBreak />
                            <LineBreak />
                            Use this Software and the associated content at your own discretion. Please be aware that using third-party modifications may occasionally lead to game instability or technical conflicts.<LineBreak />
                            <LineBreak />
                            While we aim for a seamless experience, we cannot guarantee the performance or compatibility of external content. The developers of this Software are not responsible for any technical issues or data loss that may arise from using community-made fixes.</TextBlock>

                        <Button Margin="10,0,10,30"
                                Padding="50,10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="OnConsentButtonClick"
                                Content="OK" />

                    </StackPanel>

                </Border>

            </Grid>

            <TabControl x:Name="MainTabs"
                        Grid.Row="1"
                        SelectionChanged="OnMainTabsSelectionChanged"
                        TabStripPlacement="Left"
                        Theme="{DynamicResource LauncherShellTabs}">

                <!--  Duke 3D  -->
                <TabItem x:Name="DukeTab" Theme="{DynamicResource LauncherGameTab}" IsEnabled="{Binding IsDukeTabEnabled}">

                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="30" Source="/Assets/duke3d.png" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="Duke Nukem 3D" />
                        </StackPanel>
                    </TabItem.Header>

                    <pages:GamePage DataContext="{Binding DukeViewModel}" />

                </TabItem>

                <!--  Blood  -->
                <TabItem x:Name="BloodTab" Theme="{DynamicResource LauncherGameTab}" IsEnabled="{Binding IsBloodTabEnabled}">

                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="30" Source="/Assets/blood.png" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="Blood" />
                        </StackPanel>
                    </TabItem.Header>

                    <pages:GamePage DataContext="{Binding BloodViewModel}" />

                </TabItem>

                <!--  Wang  -->
                <TabItem x:Name="WangTab" Theme="{DynamicResource LauncherGameTab}" IsEnabled="{Binding IsWangTabEnabled}">

                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="30" Source="/Assets/sw.png" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="Shadow Warrior" />
                        </StackPanel>
                    </TabItem.Header>

                    <pages:GamePage DataContext="{Binding WangViewModel}" />

                </TabItem>

                <!--  Fury  -->
                <TabItem x:Name="FuryTab" Theme="{DynamicResource LauncherGameTab}" IsEnabled="{Binding IsFuryTabEnabled}">

                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="30" Source="/Assets/fury.png" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="Ion Fury" />
                        </StackPanel>
                    </TabItem.Header>

                    <pages:GamePage DataContext="{Binding FuryViewModel}" />

                </TabItem>

                <!--  RR  -->
                <TabItem x:Name="RedneckTab" Theme="{DynamicResource LauncherGameTab}" IsEnabled="{Binding IsRedneckTabEnabled}">

                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="30" Source="/Assets/redneck.png" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="Redneck Rampage" />
                        </StackPanel>
                    </TabItem.Header>

                    <pages:GamePage DataContext="{Binding RedneckViewModel}" />

                </TabItem>

                <!--  PS  -->
                <TabItem x:Name="SlaveTab" Theme="{DynamicResource LauncherGameTab}" IsEnabled="{Binding IsSlaveTabEnabled}">

                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="30" Source="/Assets/slave.png" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="Powerslave" />
                        </StackPanel>
                    </TabItem.Header>

                    <pages:GamePage DataContext="{Binding SlaveViewModel}" />

                </TabItem>

                <!--  NAM  -->
                <TabItem x:Name="NamTab" Theme="{DynamicResource LauncherGameTab}" IsEnabled="{Binding IsNamTabEnabled}">

                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="30" Source="/Assets/nam.png" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="NAM" />
                        </StackPanel>
                    </TabItem.Header>

                    <pages:GamePage DataContext="{Binding NamViewModel}" />

                </TabItem>

                <!--  WW2  -->
                <TabItem x:Name="WW2GITab" Theme="{DynamicResource LauncherGameTab}" IsEnabled="{Binding IsWW2GITabEnabled}">

                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="30" Source="/Assets/ww2gi.png" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="WWII GI" />
                        </StackPanel>
                    </TabItem.Header>

                    <pages:GamePage DataContext="{Binding WWIIViewModel}" />

                </TabItem>

                <!--  Witchaven  -->
                <TabItem x:Name="WitchavenTab" Theme="{DynamicResource LauncherGameTab}" IsEnabled="{Binding IsWitchavenTabEnabled}">

                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="30" Source="/Assets/wh.png" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="Witchaven" />
                        </StackPanel>
                    </TabItem.Header>

                    <pages:GamePage DataContext="{Binding WitchavenViewModel}" />

                </TabItem>

                <!--  TekWar  -->
                <TabItem x:Name="TekWarTab" Theme="{DynamicResource LauncherGameTab}" IsEnabled="{Binding IsTekWarTabEnabled}">

                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="30" Source="/Assets/tw.png" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="TekWar" />
                        </StackPanel>
                    </TabItem.Header>

                    <pages:GamePage DataContext="{Binding TekWarViewModel}" />

                </TabItem>

                <!--  Standalone  -->
                <TabItem x:Name="StandaloneTab" Theme="{DynamicResource LauncherGameTab}">

                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <i:Icon Width="30" FontSize="20" Value="fa7-cube" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="Standalone" />
                        </StackPanel>
                    </TabItem.Header>

                    <pages:GamePage DataContext="{Binding StandaloneViewModel}" />

                </TabItem>

                <!--  Ports  -->
                <TabItem x:Name="PortsTab" Classes="util" Theme="{DynamicResource LauncherPillTab}">

                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ports" />
                            <i:Icon Margin="5,0,0,0"
                                    DataContext="{Binding PortsPageViewModel}"
                                    Foreground="{DynamicResource WarningBrush}"
                                    IsVisible="{Binding HasUpdates}"
                                    ToolTip.Tip="Updates available"
                                    Value="fa7-circle-exclamation" />
                        </StackPanel>
                    </TabItem.Header>

                    <Border Padding="16" Classes="column">
                        <DockPanel>
                            <TextBlock Classes="page-title" DockPanel.Dock="Top" Text="Ports" />
                            <pages:PortsPage DataContext="{Binding PortsPageViewModel}" />
                        </DockPanel>
                    </Border>
                </TabItem>

                <!--  Tools  -->
                <TabItem x:Name="ToolsTab" Classes="util" Theme="{DynamicResource LauncherPillTab}">

                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tools" />
                            <i:Icon Margin="5,0,0,0"
                                    DataContext="{Binding ToolsPageViewModel}"
                                    Foreground="{DynamicResource WarningBrush}"
                                    IsVisible="{Binding HasUpdates}"
                                    ToolTip.Tip="Updates available"
                                    Value="fa7-circle-exclamation" />
                        </StackPanel>
                    </TabItem.Header>

                    <Border Padding="16" Classes="column">
                        <DockPanel>
                            <TextBlock Classes="page-title" DockPanel.Dock="Top" Text="Tools" />
                            <pages:ToolsPage DataContext="{Binding ToolsPageViewModel}" />
                        </DockPanel>
                    </Border>
                </TabItem>

                <!--  Dev  -->
                <TabItem x:Name="DevTab"
                         Classes="util" Theme="{DynamicResource LauncherPillTab}"
                         Header="Dev">
                    <Border Padding="16" Classes="column">
                        <DockPanel>
                            <TextBlock Classes="page-title" DockPanel.Dock="Top" Text="Dev" />
                            <pages:DevPage DataContext="{Binding DevPageViewModel}" />
                        </DockPanel>
                    </Border>
                </TabItem>

                <!--  Settings  -->
                <TabItem x:Name="SettingsTab"
                         Classes="util" Theme="{DynamicResource LauncherPillTab}"
                         Header="Settings"
                         IsSelected="True">
                    <Border Padding="16" Classes="column">
                        <DockPanel>
                            <TextBlock Classes="page-title" DockPanel.Dock="Top" Text="Settings" />
                            <pages:SettingsPage DataContext="{Binding SettingsPageViewModel}" />
                        </DockPanel>
                    </Border>
                </TabItem>

                <!--  Quit  -->
                <TabItem x:Name="QuitTab" Classes="util" Theme="{DynamicResource LauncherPillTab}">

                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <i:Icon Value="fa7-power-off" />
                            <TextBlock Margin="5,0,0,0" Text="Quit" />
                        </StackPanel>
                    </TabItem.Header>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="20">

                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="24"
                                   Text="Quit Build Launcher EX?" />

                        <Button x:Name="QuitButton"
                                Padding="60,14"
                                HorizontalAlignment="Center"
                                Click="OnQuitButtonClick">
                            <StackPanel Orientation="Horizontal">
                                <i:Icon FontSize="18" Value="fa7-power-off" />
                                <TextBlock Margin="10,0,0,0"
                                           FontSize="18"
                                           Text="Quit" />
                            </StackPanel>
                        </Button>

                        <TextBlock HorizontalAlignment="Center"
                                   Opacity="0.7"
                                   Text="Controller: hold View/Back to come here, press A to quit, B or LB/RB to go back." />

                    </StackPanel>
                </TabItem>

            </TabControl>

            <Button x:Name="FullscreenButton"
                    Grid.Row="1"
                    Width="44"
                    Height="34"
                    Margin="0,13,16,0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="OnFullscreenButtonClick"
                    CornerRadius="17"
                    ToolTip.Tip="Fullscreen (F11)">
                <i:Icon Value="fa7-expand" />
            </Button>
        </Grid>
    </Border>
</Window>
