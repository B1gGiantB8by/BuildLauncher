<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:Avalonia.Desktop.Controls">

    <!--  Numbered diamond used by the column headings.  -->
    <ControlTheme x:Key="LauncherStep" TargetType="ContentControl">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Width="26" Height="26" Margin="3,0,8,0" VerticalAlignment="Center">
                    <Border Width="18"
                            Height="18"
                            Background="{DynamicResource LauncherAccentBrush}"
                            CornerRadius="3"
                            RenderTransform="rotate(45deg)" />
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding Content}"
                                      FontSize="13"
                                      FontWeight="Bold"
                                      Foreground="{DynamicResource LauncherAccentInkBrush}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  The whole window: brand, game column, page area and controller hints.  -->
    <ControlTheme x:Key="LauncherShellTabs" TargetType="TabControl">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <ctrl:LauncherTabsPanel />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Grid Margin="16,0,16,0" ColumnDefinitions="250,*" RowDefinitions="60,*,34">

                        <StackPanel Grid.ColumnSpan="2" VerticalAlignment="Center" Orientation="Horizontal">
                            <Image Width="38"
                                   Height="38"
                                   Margin="0,0,12,0"
                                   RenderOptions.BitmapInterpolationMode="None"
                                   Source="/Assets/logo.png" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource LauncherAccentBrush}"
                                       LetterSpacing="4"
                                       Text="BUILD" />
                            <TextBlock Margin="10,5,10,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="{DynamicResource LauncherMutedBrush}"
                                       LetterSpacing="6"
                                       Text="LAUNCHER" />
                            <Border Padding="8,1"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource LauncherAccentBrush}"
                                    CornerRadius="3">
                                <TextBlock FontFamily="{DynamicResource LauncherSerif}"
                                           FontSize="19"
                                           FontStyle="Italic"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource LauncherAccentInkBrush}"
                                           Text="EX" />
                            </Border>
                        </StackPanel>

                        <Border Grid.Row="1" Classes="column">
                            <StackPanel Margin="12,10,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                                <ContentControl Content="1" Theme="{DynamicResource LauncherStep}" />
                                <TextBlock Classes="column-title" Text="GAME" />
                            </StackPanel>
                        </Border>

                        <Panel Grid.Row="1"
                               Grid.Column="1"
                               Margin="14,0,0,0"
                               ClipToBounds="True">
                            <ContentPresenter Name="PART_SelectedContentHost2" IsVisible="False" />
                            <ContentPresenter Name="PART_SelectedContentHost" />
                        </Panel>

                        <TextBlock Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource LauncherMutedBrush}">
                            <Run FontWeight="Bold" Foreground="{DynamicResource LauncherAccentBrush}" Text="A" /><Run Text=" Select     " /><Run FontWeight="Bold" Foreground="{DynamicResource LauncherAccentBrush}" Text="B" /><Run Text=" Back     " /><Run FontWeight="Bold" Foreground="{DynamicResource LauncherAccentBrush}" Text="X" /><Run Text=" Menu     " /><Run FontWeight="Bold" Foreground="{DynamicResource LauncherAccentBrush}" Text="Start" /><Run Text=" Play     " /><Run FontWeight="Bold" Foreground="{DynamicResource LauncherAccentBrush}" Text="LB / RB" /><Run Text=" Game     " /><Run FontWeight="Bold" Foreground="{DynamicResource LauncherAccentBrush}" Text="LT / RT" /><Run Text=" Section     " /><Run FontWeight="Bold" Foreground="{DynamicResource LauncherAccentBrush}" Text="View" /><Run Text=" Fullscreen, hold to quit     " />
                        </TextBlock>
                    </Grid>

                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  A game card in column 1.  -->
    <ControlTheme x:Key="LauncherGameTab" TargetType="TabItem">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource LauncherInkBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root"
                        Margin="0,2"
                        Padding="8,0"
                        Background="{DynamicResource LauncherCardBrush}"
                        BorderBrush="Transparent"
                        BorderThickness="2"
                        CornerRadius="5">
                <ContentPresenter Name="PART_ContentPresenter"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource LauncherCardHoverBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#Root">
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource LauncherSelectedBrush}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#Root">
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherFocusBrush}" />
            <Setter Property="BoxShadow" Value="{DynamicResource LauncherFocusShadow}" />
        </Style>
        <Style Selector="^:disabled /template/ Border#Root">
            <Setter Property="Opacity" Value="0.38" />
        </Style>
    </ControlTheme>

    <!--  A pill in the top bar.  -->
    <ControlTheme x:Key="LauncherPillTab" TargetType="TabItem">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource LauncherMutedBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root"
                        Padding="14,0"
                        Background="{DynamicResource LauncherCardBrush}"
                        BorderBrush="{DynamicResource LauncherLineBrush}"
                        BorderThickness="1"
                        CornerRadius="17">
                <ContentPresenter Name="PART_ContentPresenter"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource LauncherInkBrush}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherMutedBrush}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{DynamicResource LauncherAccentInkBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource LauncherAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherAccentBrush}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#Root">
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherFocusBrush}" />
            <Setter Property="BoxShadow" Value="{DynamicResource LauncherFocusShadow}" />
        </Style>
    </ControlTheme>

    <!--  Campaigns / Maps / Mods / Downloads, headed as step 2.  -->
    <ControlTheme x:Key="LauncherSectionTabs" TargetType="TabControl">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="auto,*">
                    <StackPanel Margin="4,4,0,8" Orientation="Horizontal">
                        <ContentControl Content="2" Theme="{DynamicResource LauncherStep}" />
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </StackPanel>
                    <Panel Grid.Row="1" ClipToBounds="True">
                        <ContentPresenter Name="PART_SelectedContentHost2" IsVisible="False" />
                        <ContentPresenter Name="PART_SelectedContentHost" />
                    </Panel>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  A section heading with an underline when selected.  -->
    <ControlTheme x:Key="LauncherSectionTab" TargetType="TabItem">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource LauncherMutedBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root"
                        Padding="12,5"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0,0,0,2"
                        CornerRadius="3">
                <ContentPresenter Name="PART_ContentPresenter"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource LauncherInkBrush}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{DynamicResource LauncherAccentBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#Root">
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherAccentBrush}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#Root">
            <Setter Property="BoxShadow" Value="{DynamicResource LauncherFocusShadow}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
