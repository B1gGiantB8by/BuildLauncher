<ctrl:AddonListControlBase x:Class="Avalonia.Desktop.Controls.CampaignsControl"
                           xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:behaviors="clr-namespace:Avalonia.Desktop.Behaviors"
                           xmlns:ctrl="clr-namespace:Avalonia.Desktop.Controls"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:helpers="clr-namespace:Avalonia.Desktop.Helpers"
                           xmlns:i="https://github.com/projektanker/icons.avalonia"
                           xmlns:in="clr-namespace:Addons.Addons;assembly=BuildLauncher.Addons"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:vm="clr-namespace:Avalonia.Desktop.ViewModels"
                           d:DesignHeight="450"
                           d:DesignWidth="800"
                           x:DataType="vm:CampaignsViewModel"
                           mc:Ignorable="d">

    <ctrl:AddonListControlBase.Resources>
        <helpers:StringToWrappedConverter x:Key="StringToWrappedConverter" />
    </ctrl:AddonListControlBase.Resources>

    <ctrl:AddonListControlBase.DataTemplates>

        <DataTemplate x:DataType="helpers:SeparatorItem">
            <TextBlock Width="{Binding #CampaignsList.Bounds.Width}" Height="50" />
        </DataTemplate>

        <DataTemplate x:DataType="in:BaseAddon">

            <Grid Width="{x:Static helpers:DesktopConsts.GridImageWidth}" Height="{x:Static helpers:DesktopConsts.GridImageHeight}">

                <Grid IsVisible="{Binding GridImageHash, Converter={x:Static ObjectConverters.IsNotNull}}">

                    <Image HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Source="{Binding GridImageHash, Converter={StaticResource CachedHashToBitmapConverter}}" />

                    <Border Padding="8,22,8,7" VerticalAlignment="Bottom">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Offset="0" Color="#00000000" />
                                <GradientStop Offset="0.65" Color="#E0000000" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="{Binding Title}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>

                <Grid IsVisible="{Binding GridImageHash, Converter={x:Static ObjectConverters.IsNull}}">

                    <Border Background="{DynamicResource SurfaceSunken}" />

                    <Viewbox>
                        <TextBlock Margin="20"
                                   FontFamily="{DynamicResource LauncherSerif}"
                                   FontSize="500"
                                   FontStyle="Italic"
                                   Text="{Binding Title, Converter={StaticResource StringToWrappedConverter}}"
                                   TextAlignment="Center" />
                    </Viewbox>
                </Grid>

                <Border x:Name="HighlightOverlay"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,100%" EndPoint="100%,0%">
                            <GradientStop Offset="0" Color="#00F7F6FA" />
                            <GradientStop Offset="0.57" Color="#00F7F6FA" />
                            <GradientStop Offset="0.6" Color="#21F7F6FA" />
                            <GradientStop Offset="0.7" Color="#71F7F6FA" />
                            <GradientStop Offset="0.8" Color="#B2F7F6FA" />
                            <GradientStop Offset="0.9" Color="#E3F7F6FA" />
                            <GradientStop Offset="1" Color="#FFF7F6FA" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                    <i:Icon Margin="5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            BorderBrush="{DynamicResource IconOutlineBrush}"
                            BorderThickness="1"
                            FontSize="20"
                            Foreground="{DynamicResource FavoriteBrush}"
                            IsVisible="{Binding IsFavorite}"
                            Value="fa7-star" />

                    <i:Icon Margin="5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            BorderBrush="{DynamicResource IconOutlineBrush}"
                            BorderThickness="1"
                            FontSize="20"
                            Foreground="{DynamicResource WarningBrush}"
                            IsVisible="{Binding IsMetadataUpdateAvailable}"
                            ToolTip.Tip="Metadata update available"
                            Value="fa7-circle-exclamation" />

                </StackPanel>

            </Grid>

        </DataTemplate>
    </ctrl:AddonListControlBase.DataTemplates>

    <Grid ColumnDefinitions="*,380">

        <Border Padding="10" Classes="column">

            <Grid RowDefinitions="auto,*">

                <Grid Margin="0,0,0,8" ColumnDefinitions="*,auto,auto">

                    <TextBox x:Name="SearchBox"
                             PlaceholderText="Search"
                             Text="{Binding SearchBoxText}" />

                    <Button Grid.Column="1"
                            Height="{Binding Bounds.Height, ElementName=SearchBox}"
                            Margin="5,0,0,0"
                            Command="{Binding ClearSearchBoxCommand}"
                            ToolTip.Tip="Clear search">
                        <i:Icon Value="fa7-xmark" />
                    </Button>

                    <ctrl:AddonToolsControl Grid.Column="2" Margin="8,0,0,0"  />

                </Grid>

                <ListBox x:Name="CampaignsList"
                     Grid.Row="1"
                 Padding="2"
                 IsEnabled="{Binding !IsInProgress}"
                 ItemsSource="{Binding AddonsList}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectedItem="{Binding SelectedAddon}"
                 SelectionChanged="OnCampaignsListSelectionChanged">

            <ListBox.ContextMenu>
                <ContextMenu Closed="ContextMenuClosed"
                             Opened="ContextMenuOpened"
                             Opening="ContextMenuOpening" />
            </ListBox.ContextMenu>

            <Interaction.Behaviors>
                <behaviors:ClearSelectionOnEmptySpaceBehavior />
                <behaviors:AddImplicitAnimationsBehavior />
                <behaviors:FileDropBehavior Command="{Binding ProcessDroppedFilesCommand}" />
            </Interaction.Behaviors>

            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="RenderTransform" Value="scale(0.92)" />
                        <Setter Property="Transitions">
                            <Setter.Value>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
                                </Transitions>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style Selector="^ Border#HighlightOverlay">
                        <Setter Property="Opacity" Value="0.00" />
                        <Setter Property="Transitions">
                            <Setter.Value>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.5" />
                                </Transitions>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style Selector="^:pointerover">
                        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="RenderTransform" Value="scale(0.96)" />
                        </Style>

                        <Style Selector="^ Border#HighlightOverlay">
                            <Setter Property="Opacity" Value="0.2" />
                        </Style>
                    </Style>

                    <Style Selector="^:selected">
                        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="RenderTransform" Value="scale(1.0)" />
                        </Style>

                        <Style Selector="^ Border#HighlightOverlay">
                            <Setter Property="Opacity" Value="0.25" />
                        </Style>
                    </Style>
                </Style>
            </ListBox.Styles>


            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel ItemSpacing="3"
                               LineSpacing="0"
                               Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>


        </ListBox>

            </Grid>

        </Border>

        <Border Grid.Column="1"
                Margin="14,0,0,0"
                Padding="12"
                Classes="column">

            <Grid RowDefinitions="*,auto">

                <ctrl:RightPanelControl x:Name="RightPanel" />

                <ctrl:PortsButtonsControl x:Name="BottomPanel" Grid.Row="1" />

            </Grid>

        </Border>

    </Grid>

</ctrl:AddonListControlBase>
