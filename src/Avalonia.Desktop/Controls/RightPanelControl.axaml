<UserControl x:Class="Avalonia.Desktop.Controls.RightPanelControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:vm="clr-namespace:Avalonia.Desktop.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:DataType="vm:RightPanelViewModel"
             mc:Ignorable="d">

    <Grid RowDefinitions="auto,*,auto,auto,auto">

        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
            <ContentControl Content="3" Theme="{DynamicResource LauncherStep}" />
            <TextBlock Classes="column-title" Text="DETAILS" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">

            <StackPanel Orientation="Vertical">

                <Border Margin="0,0,0,8"
                        Background="{DynamicResource SurfaceSunken}"
                        ClipToBounds="True"
                        CornerRadius="4"
                        IsVisible="{Binding IsPreviewVisible}">
                    <Image MaxHeight="210" Source="{Binding SelectedAddonPreview}" />
                </Border>

                <md:MarkdownScrollViewer x:Name="Description"
                                         Margin="10,5"
                                         Markdown="{Binding SelectedAddonDescription}">

                    <md:MarkdownScrollViewer.Styles>
                        <StyleInclude Source="/Styles/MarkdownStyle.axaml" />
                    </md:MarkdownScrollViewer.Styles>

                </md:MarkdownScrollViewer>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2"
              Margin="5"
              ColumnDefinitions="auto,*"
              IsVisible="{Binding HasOptions}"
              RowDefinitions="auto,auto,auto">

            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Margin="5,10,5,5"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Text="Addon options" />

            <ItemsControl Grid.Row="1"
                          Grid.Column="0"
                          Margin="5"
                          ItemsSource="{Binding AddonOptions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="10,5"
                   HorizontalAlignment="Center"
                   FontSize="16"
                   FontWeight="Bold"
                   Text="{Binding SelectedAddonPlaytime}" />

        <StackPanel Grid.Row="4"
                    IsVisible="{Binding IsMetadataUpdateAvailable}"
                    Orientation="Horizontal">

            <TextBlock Margin="10,5"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Text="Metadata update available" />

            <Button Margin="10,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    Command="{Binding UpdateMetadataAsync}"
                    Content="Update" />

        </StackPanel>

    </Grid>

</UserControl>
