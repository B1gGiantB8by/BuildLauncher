<UserControl x:Class="Avalonia.Desktop.Controls.PortsButtonsControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:in="clr-namespace:Core.Client.Interfaces;assembly=BuildLauncher.Core.Client"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="120"
             d:DesignWidth="400"
             x:DataType="in:IPortsButtonControl"
             mc:Ignorable="d">

    <StackPanel Margin="0,10,0,0" IsVisible="{Binding IsPortsButtonsVisible}">

        <TextBlock Margin="5,0,0,4" Classes="column-title" Text="PLAY WITH" />

        <WrapPanel x:Name="PortsButtonsPanel" Orientation="Horizontal" />

    </StackPanel>

</UserControl>
